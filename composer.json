{
  "name": "totem-animal/backend",
  "description": "Totem Animal backend skeleton for a VK Mini App.",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.7",
    "php-di/php-di": "^7.1",
    "php-di/slim-bridge": "^3.4",
    "illuminate/database": "^12.0",
    "robmorgan/phinx": "^0.16",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.8",
    "symfony/validator": "^7.3",
    "symfony/cache": "^7.3",
    "symfony/console": "^7.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.70",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon --debug",
    "cs:fix": "php-cs-fixer fix --sequential --config=.php-cs-fixer.php --allow-risky=yes",
    "test": "phpunit --bootstrap vendor/autoload.php tests",
    "migrate": "phinx migrate -c phinx.php",
    "migrate:rollback": "phinx rollback -c phinx.php",
    "dump": "composer dump-autoload -o"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}
